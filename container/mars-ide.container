# MARS IDE web UI as a rootless systemd user service (podman quadlet). Optional.
# Install:  cp container/mars-ide.container ~/.config/containers/systemd/
#           systemctl --user daemon-reload && systemctl --user start mars-ide
# (stop the manually started container first: podman rm -f mars-ide)
[Unit]
Description=MARS IDE (web UI)
After=network-online.target

[Container]
Image=localhost/mars-ide:amd64
ContainerName=mars-ide
Exec=web --port 8080
# rootless podman maps container root to you on /work
User=0
Group=0
Volume=%h/mars-workspace:/work:Z
EnvironmentFile=%h/.config/mars-ide/env
# localhost + tailnet only — never the public interfaces
PublishPort=127.0.0.1:8080:8080
# optional, your tailnet address (tailscale ip -4):
#PublishPort=100.x.y.z:8080:8080
NoNewPrivileges=true
DropCapability=ALL
ReadOnly=true
Tmpfs=/tmp

[Service]
# retries until the tailscale address exists after boot
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
