# MARS IDE container: TUI (default) and web UI (`web`). Multi-arch (amd64/arm64).
# No RUN steps — everything is copied — so arm64 builds need no emulation.
FROM docker.io/library/python:3.12-slim
ARG TARGETARCH
COPY build/jre-${TARGETARCH} /opt/jre
COPY build/pylib /app/pylib
COPY build/mars-engine.jar /app/build/mars-engine.jar
COPY mars_tui /app/mars_tui
COPY examples /app/examples
COPY container/mars-entry /usr/local/bin/mars-entry
ENV PATH=/opt/jre/bin:/usr/local/bin:/usr/bin:/bin \
    PYTHONPATH=/app/pylib:/app \
    PYTHONDONTWRITEBYTECODE=1 \
    MARS_TUI_CONFIG=/work/.mars-tui \
    MARS_WEB_HOST=0.0.0.0 \
    TERM=xterm-256color \
    COLORTERM=truecolor \
    LANG=C.UTF-8 \
    HOME=/work
WORKDIR /work
# rootless Podman maps container root to the host user on /work; capabilities are dropped at run time
USER 0:0
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/mars-entry"]
